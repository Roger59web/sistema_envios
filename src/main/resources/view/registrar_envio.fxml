<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.grupo.envios.controller.RegistrarEnvioController">
    <VBox spacing="12">
        <padding>
            <Insets top="16" right="20" bottom="16" left="20"/>
        </padding>

        <Label text="Registrar envío" styleClass="titulo"/>
        <Label fx:id="dkprLblOrigen" styleClass="etiqueta"/>
        <Label fx:id="dkprLblCaja" styleClass="aviso" wrapText="true" visible="false" managed="false"
               text="No tienes un turno de caja abierto: lo que cobres no entrará en ningún cuadre. Ábrelo en Cuadre de caja."/>

        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Destino (ruta):" styleClass="etiqueta"/>
            <ComboBox fx:id="dkprCmbRuta" prefWidth="420"/>
        </HBox>

        <HBox spacing="16">
            <VBox spacing="6" styleClass="panel-form" HBox.hgrow="ALWAYS">
                <Label text="Remitente" styleClass="subtitulo"/>
                <HBox spacing="6">
                    <ComboBox fx:id="dkprCmbRemTipo" prefWidth="80"/>
                    <TextField fx:id="dkprTxtRemDoc" promptText="N° de documento" HBox.hgrow="ALWAYS"/>
                    <Button text="Buscar" onAction="#onBuscarRemitente"/>
                </HBox>
                <TextField fx:id="dkprTxtRemNombre" promptText="Nombre completo / razón social"/>
                <TextField fx:id="dkprTxtRemTelefono" promptText="Teléfono"/>
            </VBox>

            <VBox spacing="6" styleClass="panel-form" HBox.hgrow="ALWAYS">
                <Label text="Destinatario" styleClass="subtitulo"/>
                <HBox spacing="6">
                    <ComboBox fx:id="dkprCmbDesTipo" prefWidth="80"/>
                    <TextField fx:id="dkprTxtDesDoc" promptText="N° de documento" HBox.hgrow="ALWAYS"/>
                    <Button text="Buscar" onAction="#onBuscarDestinatario"/>
                </HBox>
                <TextField fx:id="dkprTxtDesNombre" promptText="Nombre completo / razón social"/>
                <TextField fx:id="dkprTxtDesTelefono" promptText="Teléfono"/>
            </VBox>
        </HBox>

        <VBox spacing="6" styleClass="panel-form">
            <Label text="Paquete" styleClass="subtitulo"/>
            <TextField fx:id="dkprTxtDescripcion" promptText="Descripción del contenido"/>
            <HBox spacing="8">
                <TextField fx:id="dkprTxtBultos" promptText="Bultos" prefWidth="90"/>
                <TextField fx:id="dkprTxtPeso" promptText="Peso (kg)" prefWidth="110"/>
                <TextField fx:id="dkprTxtValor" promptText="Valor declarado (S/), opcional" HBox.hgrow="ALWAYS"/>
            </HBox>
            <TextField fx:id="dkprTxtObservaciones" promptText="Observaciones (opcional)"/>
        </VBox>

        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="panel-form">
            <Label text="Comprobante:" styleClass="etiqueta"/>
            <ComboBox fx:id="dkprCmbComprobante"/>
            <Label text="Pago:" styleClass="etiqueta"/>
            <ComboBox fx:id="dkprCmbMetodo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Total:" styleClass="subtitulo"/>
            <Label fx:id="dkprLblCosto" styleClass="costo"/>
        </HBox>

        <HBox spacing="8" alignment="CENTER_RIGHT">
            <Button text="Limpiar" onAction="#onLimpiar"/>
            <Button text="Registrar envío" styleClass="boton-primario" onAction="#onRegistrar"/>
        </HBox>
    </VBox>
</ScrollPane>
