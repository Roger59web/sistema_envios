<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.grupo.envios.controller.RegistrarEnvioController">
    <VBox spacing="12">
        <padding>
            <Insets top="16" right="20" bottom="16" left="20"/>
        </padding>

        <Label text="Registrar envío" styleClass="titulo"/>
        <Label fx:id="lblOrigen" styleClass="etiqueta"/>

        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label text="Destino (ruta):" styleClass="etiqueta"/>
            <ComboBox fx:id="cmbRuta" prefWidth="420"/>
        </HBox>

        <HBox spacing="16">
            <VBox spacing="6" styleClass="panel-form" HBox.hgrow="ALWAYS">
                <Label text="Remitente" styleClass="subtitulo"/>
                <HBox spacing="6">
                    <ComboBox fx:id="cmbRemTipo" prefWidth="80"/>
                    <TextField fx:id="txtRemDoc" promptText="N° de documento" HBox.hgrow="ALWAYS"/>
                    <Button text="Buscar" onAction="#onBuscarRemitente"/>
                </HBox>
                <TextField fx:id="txtRemNombre" promptText="Nombre completo / razón social"/>
                <TextField fx:id="txtRemTelefono" promptText="Teléfono"/>
            </VBox>

            <VBox spacing="6" styleClass="panel-form" HBox.hgrow="ALWAYS">
                <Label text="Destinatario" styleClass="subtitulo"/>
                <HBox spacing="6">
                    <ComboBox fx:id="cmbDesTipo" prefWidth="80"/>
                    <TextField fx:id="txtDesDoc" promptText="N° de documento" HBox.hgrow="ALWAYS"/>
                    <Button text="Buscar" onAction="#onBuscarDestinatario"/>
                </HBox>
                <TextField fx:id="txtDesNombre" promptText="Nombre completo / razón social"/>
                <TextField fx:id="txtDesTelefono" promptText="Teléfono"/>
            </VBox>
        </HBox>

        <VBox spacing="6" styleClass="panel-form">
            <Label text="Paquete" styleClass="subtitulo"/>
            <TextField fx:id="txtDescripcion" promptText="Descripción del contenido"/>
            <HBox spacing="8">
                <TextField fx:id="txtBultos" promptText="Bultos" prefWidth="90"/>
                <TextField fx:id="txtPeso" promptText="Peso (kg)" prefWidth="110"/>
                <TextField fx:id="txtValor" promptText="Valor declarado (S/), opcional" HBox.hgrow="ALWAYS"/>
            </HBox>
            <TextField fx:id="txtObservaciones" promptText="Observaciones (opcional)"/>
        </VBox>

        <HBox spacing="12" alignment="CENTER_LEFT" styleClass="panel-form">
            <Label text="Comprobante:" styleClass="etiqueta"/>
            <ComboBox fx:id="cmbComprobante"/>
            <Label text="Pago:" styleClass="etiqueta"/>
            <ComboBox fx:id="cmbMetodo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Total:" styleClass="subtitulo"/>
            <Label fx:id="lblCosto" styleClass="costo"/>
        </HBox>

        <HBox spacing="8" alignment="CENTER_RIGHT">
            <Button text="Limpiar" onAction="#onLimpiar"/>
            <Button text="Registrar envío" styleClass="boton-primario" onAction="#onRegistrar"/>
        </HBox>
    </VBox>
</ScrollPane>
