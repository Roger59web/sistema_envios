<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="12" prefWidth="380" prefHeight="340" styleClass="login-box"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.grupo.envios.controller.LoginController">
    <padding>
        <Insets top="30" right="40" bottom="30" left="40"/>
    </padding>

    <Label text="Sistema de Envíos" styleClass="titulo"/>
    <Label text="Ingreso de personal de ventanilla"/>
    <TextField fx:id="dkprTxtUsuario" promptText="Usuario"/>
    <PasswordField fx:id="dkprTxtClave" promptText="Contraseña" onAction="#onIngresar"/>
    <Label fx:id="dkprLblError" styleClass="error" wrapText="true"/>
    <Button text="Ingresar" defaultButton="true" maxWidth="Infinity" onAction="#onIngresar"/>
</VBox>
