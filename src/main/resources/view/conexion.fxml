<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="6" prefWidth="380" styleClass="login-box"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.grupo.envios.controller.ConexionController">
    <padding>
        <Insets top="24" right="40" bottom="24" left="40"/>
    </padding>

    <Label text="Configuración de conexión" styleClass="subtitulo"/>
    <Label text="Datos del servidor PostgreSQL" wrapText="true"/>

    <Label text="Servidor" styleClass="etiqueta"/>
    <TextField fx:id="dkprTxtServidor" promptText="localhost"/>
    <Label text="Puerto" styleClass="etiqueta"/>
    <TextField fx:id="dkprTxtPuerto" promptText="5432"/>
    <Label text="Base de datos" styleClass="etiqueta"/>
    <TextField fx:id="dkprTxtBase" promptText="sistema_envios"/>
    <Label text="Usuario" styleClass="etiqueta"/>
    <TextField fx:id="dkprTxtUsuario" promptText="postgres"/>
    <Label text="Contraseña" styleClass="etiqueta"/>
    <PasswordField fx:id="dkprTxtClave" promptText="Contraseña" onAction="#onGuardar"/>

    <Label fx:id="dkprLblMensaje" wrapText="true"/>

    <HBox spacing="8" alignment="CENTER_RIGHT">
        <padding>
            <Insets top="6"/>
        </padding>
        <Button text="Probar conexión" onAction="#onProbar"/>
        <Button text="Guardar" styleClass="boton-primario" onAction="#onGuardar"/>
    </HBox>
</VBox>
