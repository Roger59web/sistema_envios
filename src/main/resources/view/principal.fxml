<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="1100" prefHeight="680"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.grupo.envios.controller.PrincipalController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="barra-superior">
            <padding>
                <Insets top="12" right="20" bottom="12" left="20"/>
            </padding>
            <Label text="Sistema de Envíos" styleClass="titulo-barra"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="dkprLblUsuario" styleClass="texto-barra"/>
            <Button fx:id="dkprBtnCerrarSesion" text="Cerrar sesión" onAction="#onCerrarSesion"/>
        </HBox>
    </top>

    <left>
        <VBox spacing="6" styleClass="menu-lateral" prefWidth="210">
            <padding>
                <Insets top="16" right="12" bottom="16" left="12"/>
            </padding>
            <Button text="Inicio" maxWidth="Infinity" onAction="#onInicio"/>

            <Label text="OPERACIÓN" styleClass="seccion-menu"/>
            <Button text="Bandeja de agencia" maxWidth="Infinity" onAction="#onBandeja"/>
            <Button text="Control de carga" maxWidth="Infinity" onAction="#onControlCarga"/>
            <Button fx:id="dkprBtnEstancados" text="Paquetes estancados" maxWidth="Infinity" onAction="#onEstancados"/>
            <Button fx:id="dkprBtnClientes" text="Clientes" maxWidth="Infinity" onAction="#onClientes"/>
            <Button fx:id="dkprBtnEnvio" text="Registrar envío" maxWidth="Infinity" onAction="#onRegistrarEnvio"/>
            <Button text="Seguimiento" maxWidth="Infinity" onAction="#onSeguimiento"/>
            <Button fx:id="dkprBtnEntregas" text="Entregas" maxWidth="Infinity" onAction="#onEntregas"/>
            <Button fx:id="dkprBtnCaja" text="Cuadre de caja" maxWidth="Infinity" onAction="#onCaja"/>

            <VBox fx:id="dkprSeccionAdmin" spacing="6">
                <Label text="ADMINISTRACIÓN" styleClass="seccion-menu"/>
                <Button text="Reportes" maxWidth="Infinity" onAction="#onReportes"/>
                <Button text="Agencias" maxWidth="Infinity" onAction="#onAgencias"/>
                <Button text="Rutas y tarifas" maxWidth="Infinity" onAction="#onRutas"/>
                <Button text="Vehículos y conductores" maxWidth="Infinity" onAction="#onVehiculos"/>
                <Button text="Empleados" maxWidth="Infinity" onAction="#onEmpleados"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="dkprContenido"/>
    </center>
</BorderPane>
