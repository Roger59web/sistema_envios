<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox spacing="16" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.grupo.envios.controller.EmpleadosController">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <VBox spacing="8" HBox.hgrow="ALWAYS">
        <Label text="Empleados" styleClass="titulo"/>
        <TableView fx:id="dkprTabla" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="dkprColDni" text="DNI" prefWidth="80"/>
                <TableColumn fx:id="dkprColNombre" text="Nombre" prefWidth="170"/>
                <TableColumn fx:id="dkprColUsuario" text="Usuario" prefWidth="90"/>
                <TableColumn fx:id="dkprColRol" text="Rol" prefWidth="110"/>
                <TableColumn fx:id="dkprColAgencia" text="Agencia" prefWidth="140"/>
                <TableColumn fx:id="dkprColEstado" text="Estado" prefWidth="70"/>
            </columns>
        </TableView>
    </VBox>

    <VBox spacing="6" prefWidth="320" minWidth="320" styleClass="panel-form">
        <Label fx:id="dkprLblModo" styleClass="subtitulo"/>
        <Label text="Agencia" styleClass="etiqueta"/>
        <ComboBox fx:id="dkprCmbAgencia" maxWidth="Infinity"/>
        <Label text="Rol" styleClass="etiqueta"/>
        <ComboBox fx:id="dkprCmbRol" maxWidth="Infinity"/>
        <Label text="DNI" styleClass="etiqueta"/>
        <TextField fx:id="dkprTxtDni"/>
        <Label text="Nombres" styleClass="etiqueta"/>
        <TextField fx:id="dkprTxtNombres"/>
        <Label text="Apellidos" styleClass="etiqueta"/>
        <TextField fx:id="dkprTxtApellidos"/>
        <Label text="Usuario" styleClass="etiqueta"/>
        <TextField fx:id="dkprTxtUsuario"/>
        <Label text="Contraseña" styleClass="etiqueta"/>
        <PasswordField fx:id="dkprTxtClave"/>
        <CheckBox fx:id="dkprChkActivo" text="Empleado activo"/>
        <HBox spacing="8" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10"/>
            </padding>
            <Button text="Nuevo" onAction="#onNuevo"/>
            <Button text="Guardar" styleClass="boton-primario" onAction="#onGuardar"/>
        </HBox>
    </VBox>
</HBox>
