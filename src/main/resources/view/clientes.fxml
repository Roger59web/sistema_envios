<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox spacing="16" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.grupo.envios.controller.ClientesController">
    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <VBox spacing="8" HBox.hgrow="ALWAYS">
        <Label text="Clientes" styleClass="titulo"/>
        <HBox spacing="8">
            <TextField fx:id="dkprTxtBuscar" promptText="Buscar por documento o nombre" HBox.hgrow="ALWAYS"/>
            <Button text="Buscar" onAction="#onBuscar"/>
        </HBox>
        <TableView fx:id="dkprTabla" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="dkprColTipo" text="Tipo" prefWidth="60"/>
                <TableColumn fx:id="dkprColDocumento" text="Documento" prefWidth="110"/>
                <TableColumn fx:id="dkprColNombre" text="Nombre / Razón social" prefWidth="250"/>
                <TableColumn fx:id="dkprColTelefono" text="Teléfono" prefWidth="110"/>
            </columns>
        </TableView>
    </VBox>

    <VBox spacing="6" prefWidth="320" minWidth="320" styleClass="panel-form">
        <Label fx:id="dkprLblModo" styleClass="subtitulo"/>
        <Label text="Tipo de documento" styleClass="etiqueta"/>
        <ComboBox fx:id="dkprCmbTipo" maxWidth="Infinity"/>
        <Label text="Número de documento" styleClass="etiqueta"/>
        <TextField fx:id="dkprTxtDocumento"/>
        <Label text="Nombre completo / Razón social" styleClass="etiqueta"/>
        <TextField fx:id="dkprTxtNombre"/>
        <Label text="Teléfono" styleClass="etiqueta"/>
        <TextField fx:id="dkprTxtTelefono"/>
        <Label text="Correo electrónico" styleClass="etiqueta"/>
        <TextField fx:id="dkprTxtEmail"/>
        <Label text="Dirección" styleClass="etiqueta"/>
        <TextField fx:id="dkprTxtDireccion"/>
        <HBox spacing="8" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10"/>
            </padding>
            <Button text="Nuevo" onAction="#onNuevo"/>
            <Button text="Guardar" styleClass="boton-primario" onAction="#onGuardar"/>
        </HBox>
    </VBox>
</HBox>
