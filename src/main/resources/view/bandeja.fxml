<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.grupo.envios.controller.BandejaController">
    <padding>
        <Insets top="16" right="20" bottom="16" left="20"/>
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Bandeja de la agencia" styleClass="titulo"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Agencia:" styleClass="etiqueta"/>
        <ComboBox fx:id="dkprCmbAgencia" prefWidth="240"/>
        <Button text="Actualizar" onAction="#onActualizar"/>
    </HBox>

    <TabPane fx:id="dkprTabs" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

        <!-- 1. Paquetes registrados aquí que esperan salir -->
        <Tab fx:id="dkprTabDespachar" text="Por despachar">
            <VBox spacing="8">
                <padding>
                    <Insets top="10"/>
                </padding>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <ComboBox fx:id="dkprCmbDestino" promptText="Destino" prefWidth="240"/>
                    <TextField fx:id="dkprTxtEscanearDespacho" promptText="Escanea o escribe el código y pulsa Enter"
                               HBox.hgrow="ALWAYS"/>
                    <Button text="Marcar todos" onAction="#onMarcarTodosDespacho"/>
                </HBox>
                <TableView fx:id="dkprTablaDespachar" editable="true" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="dkprColDespMarca" text="✔" prefWidth="40" sortable="false"/>
                        <TableColumn fx:id="dkprColDespCodigo" text="Código" prefWidth="110"/>
                        <TableColumn fx:id="dkprColDespDestino" text="Destino" prefWidth="160"/>
                        <TableColumn fx:id="dkprColDespDestinatario" text="Destinatario" prefWidth="190"/>
                        <TableColumn fx:id="dkprColDespBultos" text="Bultos" prefWidth="60"/>
                        <TableColumn fx:id="dkprColDespPeso" text="Peso kg" prefWidth="70"/>
                        <TableColumn fx:id="dkprColDespFecha" text="Registrado" prefWidth="125"/>
                        <TableColumn fx:id="dkprColDespAlerta" text="Alerta" prefWidth="150"/>
                    </columns>
                    <placeholder>
                        <Label text="No hay envíos pendientes de despacho."/>
                    </placeholder>
                </TableView>
                <VBox spacing="6" styleClass="panel-form">
                    <Label text="Manifiesto de carga" styleClass="subtitulo"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <ComboBox fx:id="dkprCmbVehiculo" promptText="Vehículo (placa)" prefWidth="190"/>
                        <ComboBox fx:id="dkprCmbConductor" promptText="Conductor" prefWidth="220"/>
                        <TextField fx:id="dkprTxtObsDespacho" promptText="Observación (opcional)" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="dkprBtnDespachar" text="Despachar" styleClass="boton-primario"
                                onAction="#onDespachar"/>
                    </HBox>
                </VBox>
            </VBox>
        </Tab>

        <!-- 2. Paquetes que vienen en camino hacia esta agencia -->
        <Tab fx:id="dkprTabRecibir" text="Por recibir">
            <VBox spacing="8">
                <padding>
                    <Insets top="10"/>
                </padding>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <TextField fx:id="dkprTxtEscanearRecibir" promptText="Escanea cada paquete que baja del vehículo y pulsa Enter"
                               HBox.hgrow="ALWAYS"/>
                    <Button text="Marcar todos" onAction="#onMarcarTodosRecibir"/>
                </HBox>
                <TableView fx:id="dkprTablaRecibir" editable="true" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="dkprColRecMarca" text="✔" prefWidth="40" sortable="false"/>
                        <TableColumn fx:id="dkprColRecCodigo" text="Código" prefWidth="110"/>
                        <TableColumn fx:id="dkprColRecOrigen" text="Origen" prefWidth="160"/>
                        <TableColumn fx:id="dkprColRecManifiesto" text="Manifiesto" prefWidth="110"/>
                        <TableColumn fx:id="dkprColRecVehiculo" text="Vehículo" prefWidth="90"/>
                        <TableColumn fx:id="dkprColRecBultos" text="Bultos" prefWidth="60"/>
                        <TableColumn fx:id="dkprColRecSalida" text="Salió" prefWidth="125"/>
                        <TableColumn fx:id="dkprColRecEstimada" text="Llegada estimada" prefWidth="120"/>
                        <TableColumn fx:id="dkprColRecAlerta" text="Alerta" prefWidth="150"/>
                    </columns>
                    <placeholder>
                        <Label text="No hay envíos en camino hacia esta agencia."/>
                    </placeholder>
                </TableView>
                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="panel-form">
                    <TextField fx:id="dkprTxtObsRecepcion" promptText="Observación (ej: caja golpeada)" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="dkprBtnRecibir" text="Confirmar llegada" styleClass="boton-primario"
                            onAction="#onRecibir"/>
                </HBox>
            </VBox>
        </Tab>

        <!-- 3. Paquetes en esta agencia esperando que el destinatario los recoja -->
        <Tab fx:id="dkprTabEntregar" text="Por entregar">
            <VBox spacing="8">
                <padding>
                    <Insets top="10"/>
                </padding>
                <Label text="Doble clic en un envío para registrar su entrega." styleClass="aviso"/>
                <TableView fx:id="dkprTablaEntregar" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="dkprColEntCodigo" text="Código" prefWidth="110"/>
                        <TableColumn fx:id="dkprColEntDestinatario" text="Destinatario" prefWidth="200"/>
                        <TableColumn fx:id="dkprColEntDocumento" text="Documento" prefWidth="110"/>
                        <TableColumn fx:id="dkprColEntTelefono" text="Teléfono" prefWidth="100"/>
                        <TableColumn fx:id="dkprColEntOrigen" text="Origen" prefWidth="150"/>
                        <TableColumn fx:id="dkprColEntLlego" text="Llegó" prefWidth="125"/>
                        <TableColumn fx:id="dkprColEntAlerta" text="Alerta" prefWidth="190"/>
                    </columns>
                    <placeholder>
                        <Label text="No hay envíos esperando entrega."/>
                    </placeholder>
                </TableView>
                <HBox alignment="CENTER_RIGHT">
                    <Button text="Entregar seleccionado" styleClass="boton-primario" onAction="#onEntregar"/>
                </HBox>
            </VBox>
        </Tab>
    </TabPane>
</VBox>
